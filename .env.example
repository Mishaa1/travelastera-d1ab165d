# Server-only provider credentials. Never prefix these with VITE_.
#
# Duffel Developer test-mode token:
# https://app.duffel.com/
DUFFEL_ACCESS_TOKEN=duffel_test_replace_me

# Hotelbeds Hotels API Suite evaluation credentials:
# https://developer.hotelbeds.com/
HOTELBEDS_API_KEY=replace_me
HOTELBEDS_API_SECRET=replace_me

# Optional. The Hotelbeds evaluation endpoint is used by default.
HOTELBEDS_BASE_URL=https://api.test.hotelbeds.com
HOTELBEDS_AVAILABILITY_TTL_MS=21600000
HOTELBEDS_CONTENT_TTL_MS=1209600000

# OpenRouter is server-only. The default planner is Qwen 3's free variant;
# override the slug if OpenRouter changes free-model availability.
OPENROUTER_API_KEY=replace_me
OPENROUTER_PLANNER_MODEL=openrouter/free

# OpenTripMap supplies live attractions, food venues and available preview images.
# Create a free key at https://dev.opentripmap.org/
OPENTRIPMAP_API_KEY=replace_me

# Optional no-key live POI fallback. OpenStreetMap/Overpass remains factual data,
# not sample inventory.
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter

# Primary live places provider. Keep this key server-only; never prefix it with VITE_ or PUBLIC_.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_BASE_URL=https://places.googleapis.com/v1

# Authentication and optional OAuth SSO (server-only)
# Generate a long random value for production.
AUTH_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PEM contents may use literal \n sequences.
APPLE_PRIVATE_KEY=
GOOGLE_PLACES_ENABLED=true
GOOGLE_PLACES_LANGUAGE_CODE=en
GOOGLE_PLACES_REGION_CODE=FR
GOOGLE_PLACES_ATTRACTION_RADIUS_METERS=10000
GOOGLE_PLACES_RESTAURANT_RADIUS_METERS=5000
GOOGLE_PLACES_MAX_ATTRACTIONS_PER_CITY=12
GOOGLE_PLACES_MAX_RESTAURANTS_PER_CITY=10
GOOGLE_PLACES_MAX_PHOTOS_PER_ITINERARY=4
GOOGLE_PLACES_MONTHLY_REQUEST_LIMIT=800
GOOGLE_PLACES_DAILY_REQUEST_LIMIT=40
GOOGLE_PLACES_HOURLY_REQUEST_LIMIT=10
GOOGLE_PLACES_MAX_REQUESTS_PER_USER_PER_HOUR=5
GOOGLE_PLACES_MAX_CALLS_PER_ITINERARY=3
GOOGLE_PLACES_MONTHLY_SAFETY_BUFFER=200
POI_CACHE_TTL_SECONDS=604800
PLACE_DETAILS_CACHE_TTL_SECONDS=2592000
PLACE_PHOTO_CACHE_TTL_SECONDS=2592000
TRACK_GOOGLE_PLACES_USAGE=true
SHOW_GOOGLE_PLACES_USAGE_IN_PROVENANCE=true
ALLOW_OVERPASS_POI_FALLBACK=true
ALLOW_MOCK_POIS=false

# Development safety gate. Searches fail instead of substituting mock/provider
# fallback content when any required integration is unavailable.
REQUIRE_LIVE_DATA=false
ALLOW_LABELLED_DEMO_HOTELS=true

# Optional OpenRouter attribution header.
APP_URL=http://localhost:3000
# Increment when the editorial Destination Mood selection algorithm changes.
DESTINATION_MOOD_IMAGE_VERSION=6
